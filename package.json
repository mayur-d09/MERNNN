{
  "name": "supms-smart-parking-system",
  "version": "1.0.0",
  "description": "Smart Urban Parking Management System - MERN Stack",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "install-server": "cd backend && npm install",
    "install-client": "cd frontend && npm install",
    "install-all": "npm run install-server && npm run install-client",
    "seed": "cd backend && npm run seed"
  },
  "keywords": [
    "mern",
    "parking",
    "smart-city",
    "react",
    "nodejs",
    "mongodb",
    "websocket"
  ],
  "author": "mayur-d09",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "path": "^0.12.7",
    "serve-static": "^1.15.0",
    "cors": "^2.8.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
