{
  "name": "supms-parking-mern",
  "version": "1.0.0",
  "description": "Smart Urban Parking Management System - MERN Stack (Backend + Frontend build)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:frontend",
    "build:frontend": "react-scripts build",
    "seed": "cd backend && node seed.js",
    "install:backend": "cd backend && npm install",
    "heroku-postbuild": "npm run build:frontend"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.2",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
